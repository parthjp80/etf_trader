APCA_BASE_URL=https://paper-api.alpaca.markets
# Must be explicitly true to point APCA_BASE_URL at a live account
ALLOW_LIVE=false
# true = compute and log the plan, place no orders
DRY_RUN=false
# Only act when at most this many minutes remain before the close
RUN_WINDOW_MINUTES=20
LOG_PATH=/app/logs
# End-of-day email (credentials in secret.env)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
# Claude's second look before each boost into SSO/QLD: off | shadow | enforce
# (see etf_trader/ai_review.py). shadow asks and logs but trades as if off.
# ANTHROPIC_API_KEY comes from k8s/anthropic-secret.env (sops-encrypted;
# edit with `sops k8s/anthropic-secret.env`).
AI_REVIEW=shadow
AI_REVIEW_MODEL=claude-opus-5-5
# enforce only: if Claude can't be reached, closed = stay in 1x, open = boost
AI_REVIEW_FAIL_MODE=closed
