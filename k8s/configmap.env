APCA_BASE_URL=https://paper-api.alpaca.markets
# Must be explicitly true to point APCA_BASE_URL at a live account
ALLOW_LIVE=false
# true = compute and log the plan, place no orders
DRY_RUN=false
# Only act when at most this many minutes remain before the close
RUN_WINDOW_MINUTES=20
LOG_PATH=/app/logs
# End-of-day email (credentials in secret.env)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
