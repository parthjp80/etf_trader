# Copy to k8s/secret.env, fill in, then encrypt in place:
#   sops -e -i k8s/secret.env
# Use a DEDICATED Alpaca paper account — the bot refuses to run if the
# account holds anything outside its ETF universe.
APCA_KEY_ID=
APCA_SECRET_KEY=
# End-of-day report (Gmail: a 16-char app password)
EMAIL_FROM=
EMAIL_TO=
EMAIL_PASSWORD=
